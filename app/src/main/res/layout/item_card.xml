<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_height"
        android:background="@drawable/bg_card_back"
        android:contentDescription="@string/card_content_description"
        android:elevation="2dp">

        <!-- 背面：显示统一的翻牌底纹符号 -->
        <TextView
            android:id="@+id/card_back_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/card_back_symbol"
            android:textColor="@color/card_back_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- 正面：显示点数与花色 -->
        <LinearLayout
            android:id="@+id/card_face_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_card_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_red"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_card_suit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/red_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
